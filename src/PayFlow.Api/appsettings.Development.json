{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=payflow;Username=payflow;Password=devpassword",
    "Redis": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Consumers": {
      "Enabled": true
    },
    "ConsumerGroups": {
      "WebhookDispatch": "webhook-dispatch-group",
      "WebhookDelivery": "webhook-delivery-group",
      "DLQMonitor": "dlq-monitor-group",
      "Notification": "notification-group"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "FreeTierLimit": 1000,
    "ProTierLimit": 10000,
    "WindowSeconds": 60,
    "AuthRegisterLimit": 50,
    "AuthTokenLimit": 100
  },
  "Jwt": {
    "Key": "dev-only-secret-key-minimum-32-chars-long"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
