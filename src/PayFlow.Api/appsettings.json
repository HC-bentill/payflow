{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "Consumers": {
      "Enabled": true
    },
    "ConsumerGroups": {
      "WebhookDispatch": "webhook-dispatch-group",
      "WebhookDelivery": "webhook-delivery-group",
      "DLQMonitor": "dlq-monitor-group",
      "Notification": "notification-group"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "FreeTierLimit": 100,
    "ProTierLimit": 1000,
    "WindowSeconds": 60,
    "AuthRegisterLimit": 10,
    "AuthTokenLimit": 20
  },
  "Jwt": {
    "Key": "",
    "Issuer": "payflow",
    "Audience": "payflow-api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
